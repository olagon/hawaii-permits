{
  "$id": "https://olagon.github.io/ala/schema/common.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "date": { "type": "string", "format": "date" },
    "money": { "oneOf": [ { "type": "number", "minimum": 0 }, { "const": "see_source" } ] },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/url" } },
    "island": { "enum": ["oahu", "kauai", "niihau", "maui", "molokai", "lanai", "kahoolawe", "hawaii"] }
  }
}
